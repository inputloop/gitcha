#!/bin/sh
# debconf questions for inputloop-gitcha-medic.  A preseed file answers them all: deploy/preseed.example.cfg.
# Copyright 2026 Corwin Brust <corwin@bru.st> and Bryant Frankford <nathanielfrankford@gmail.com> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
set -e
. /usr/share/debconf/confmodule

db_input medium inputloop-gitcha-medic/heal || true
db_input medium inputloop-gitcha-medic/channels || true
db_go || true

# Each chosen channel: what it needs, and only that.
db_get inputloop-gitcha-medic/channels; channels=$RET
has() { case ", $channels," in *", $1,"*) return 0 ;; esac; return 1; }
if has tavern; then for q in tavern_agent_json tavern_room; do db_input medium "inputloop-gitcha-medic/$q" || true; done; fi
if has chadgram; then db_input medium inputloop-gitcha-medic/chadgram_file || true; fi
if has webhook; then db_input medium inputloop-gitcha-medic/webhook_url || true; fi
if has c4; then db_input medium inputloop-gitcha-medic/c4_dir || true; fi
db_go || true

db_input medium inputloop-gitcha-medic/agent || true
db_go || true
db_get inputloop-gitcha-medic/agent
if [ "$RET" != none ]; then
  for q in agent_model agent_url; do db_input medium "inputloop-gitcha-medic/$q" || true; done
  db_input high inputloop-gitcha-medic/agent_key || true
  db_go || true
fi

db_input medium inputloop-gitcha-medic/enable || true
db_go || true
