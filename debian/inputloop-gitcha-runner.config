#!/bin/sh
# debconf questions for inputloop-gitcha-runner.  A preseed file answers them all: deploy/preseed.example.cfg.
# Copyright 2026 Bryant Frankford <nathanielfrankford@gmail.com> and Corwin Brust <corwin@bru.st> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
set -e
. /usr/share/debconf/confmodule

# A runner that is registered already keeps its registration: nothing to ask but whether to start it.
if [ ! -f /var/lib/gitcha-runner/runner.json ]; then
  db_input medium inputloop-gitcha-runner/server_url || true
  db_go || true
  db_get inputloop-gitcha-runner/server_url
  if [ -n "$RET" ]; then
    for q in registration_token name labels; do db_input medium "inputloop-gitcha-runner/$q" || true; done
    db_go || true
  fi
fi
db_input medium inputloop-gitcha-runner/enable || true
db_go || true
