#!/bin/sh
# debconf questions for inputloop-gitcha.  A preseed file answers them all: deploy/preseed.example.cfg.
# Copyright 2026 Bryant Frankford <nathanielfrankford@gmail.com> and Corwin Brust <corwin@bru.st> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
set -e
. /usr/share/debconf/confmodule
# yes or no: was this package built with Cassandra support (debian/rules fills it in)?
WITH_CASSANDRA=@WITH_CASSANDRA@

db_input high inputloop-gitcha/public_url || true
db_input medium inputloop-gitcha/hosting_domains || true
if [ "$WITH_CASSANDRA" = yes ]; then db_input high inputloop-gitcha/store || true; fi
db_go || true

db_get inputloop-gitcha/store
if [ "$WITH_CASSANDRA" = yes ] && [ "$RET" = cassandra ]; then
  # No Cassandra on this machine: offer to set one up (gitcha-setup-cassandra, run once this installation ends).
  setup=false
  if ! dpkg-query -W -f='${Status}' cassandra 2>/dev/null | grep -q 'install ok installed'; then
    db_input high inputloop-gitcha/cassandra_setup || true
    db_go || true
    db_get inputloop-gitcha/cassandra_setup; setup=$RET
  fi
  if [ "$setup" = true ]; then
    # One local node, as it comes out of its package: no questions about where it is or how to log in.
    db_set inputloop-gitcha/cassandra_contact_points 127.0.0.1
    db_set inputloop-gitcha/cassandra_datacenter datacenter1
    db_set inputloop-gitcha/cassandra_replication SimpleStrategy:1
    db_set inputloop-gitcha/cassandra_username ""
    for q in keyspace instance; do db_input medium "inputloop-gitcha/cassandra_$q" || true; done
    db_go || true
  else
    db_input high inputloop-gitcha/cassandra_contact_points || true
    for q in datacenter keyspace instance replication username; do
      db_input medium "inputloop-gitcha/cassandra_$q" || true
    done
    db_go || true
    db_get inputloop-gitcha/cassandra_username
    if [ -n "$RET" ]; then db_input high inputloop-gitcha/cassandra_password || true; db_go || true; fi
  fi
fi

db_input medium inputloop-gitcha/enable || true
db_go || true
