# gitcha-runner.service -- a Gitcha runner using bContain VMs.  Not enabled by the package.
# Copyright 2026 Bryant Frankford <nathanielfrankford@gmail.com> and Corwin Brust <corwin@bru.st> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
[Unit]
Description=Gitcha runner (each job in its own bContain VM)
After=network-online.target
Wants=network-online.target
[Service]
User=gitcha-runner
Group=gitcha-runner
SupplementaryGroups=kvm
Environment=GITCHA_RUNNER_HOME=/var/lib/gitcha-runner BCONTAIN_HOME=/var/lib/gitcha-runner/bcontain
StateDirectory=gitcha-runner
StateDirectoryMode=0700
ExecStart=/usr/bin/gitcha-runner run --concurrency 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Not tried against a real bContain job yet: if a job proves it needs a capability or another address family, relax that line.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/gitcha-runner
# Ceilings (the keepers' numbers): two VMs of 2 GiB each by default, and what bContain starts around them.
MemoryMax=6G
TasksMax=1024
[Install]
WantedBy=multi-user.target
