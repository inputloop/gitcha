# gitcha.env -- settings for the Gitcha server (a conffile: your edits survive upgrades).
# Copyright 2026 Bryant Frankford <nathanielfrankford@gmail.com> and Corwin Brust <corwin@bru.st> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
# Readable by root and the gitcha group only.  Every setting the server reads is listed here (a # line shows the
# default); DEPLOY.md says what the less obvious ones do.

# Where people reach this instance (https in production; enables Secure cookies).
GITCHA_PUBLIC_URL=https://gitcha.example.org
GITCHA_HOST=127.0.0.1
GITCHA_PORT=4873
# The TLS proxy in front sets X-Forwarded-For.  Leave this on only when that proxy is the one way in (see DEPLOY.md).
GITCHA_TRUST_PROXY=true
# With that on, how many proxies stand in front (a whole number, default 1), or a comma list of their addresses or ranges
# (10.0.0.0/8, 2001:db8::/32); only the address a trusted proxy reports is believed.
#GITCHA_TRUSTED_PROXIES=1

# Where the database, repositories, sites and keys live (the unit sets /var/lib/gitcha) and who may register.
#GITCHA_DATA_DIR=/var/lib/gitcha
#GITCHA_SECRET_KEY=            # default: a key generated into the data directory; set only to bring your own
#GITCHA_ISSUER=Gitcha          # the name shown in authenticator apps
#GITCHA_OPEN_REGISTRATION=true # false: only the first (administrator) account may register
#GITCHA_PUBLIC_READ=false      # true: public repositories and packages can be read without an account

# The database: cassandra (an Apache Cassandra keyspace; the packages' default) or file (db.json in the data
# directory; the default when this line is absent, and what a package built without Cassandra ships here).
# Blobs, git repositories, sites and secret.key stay in the data directory either way.
# cassandra needs a Cassandra node that is up at the address below; without one the server will not start
# (journalctl -u gitcha and gitcha-check say why). No Cassandra on this machine or network: set file.
GITCHA_STORE=cassandra
# Nodes to connect to (host or host:port, comma separated; 9042 when no port) and the data center they are in.
GITCHA_CASSANDRA_CONTACT_POINTS=127.0.0.1
#GITCHA_CASSANDRA_DATACENTER=datacenter1
# The keyspace, and this server's name in it: several Gitcha servers may share one keyspace, one instance each.
#GITCHA_CASSANDRA_KEYSPACE=gitcha
#GITCHA_CASSANDRA_INSTANCE=main
# Made at first start if missing (no: the keyspace must already exist), with this replication.
#GITCHA_CASSANDRA_CREATE_KEYSPACE=yes
#GITCHA_CASSANDRA_REPLICATION=SimpleStrategy:1   # or NetworkTopologyStrategy:dc1=3,dc2=3
#GITCHA_CASSANDRA_CONSISTENCY=LOCAL_QUORUM
#GITCHA_CASSANDRA_USERNAME=
#GITCHA_CASSANDRA_PASSWORD=
#GITCHA_CASSANDRA_TLS=no
#GITCHA_CASSANDRA_CA_FILE=
# How long one save may wait for Cassandra before it fails.
#GITCHA_CASSANDRA_TIMEOUT=15s

# Sessions and two-factor timing.
#GITCHA_STEPUP_INTERVAL=12h
#GITCHA_STEPUP_ON_NEW_NETWORK=yes
#GITCHA_SENSITIVE_WINDOW=10m
#GITCHA_SESSION_IDLE=7d
#GITCHA_SESSION_MAX_AGE=30d

# Size limits.
#GITCHA_MAX_PACKAGE_BYTES=26214400
#GITCHA_MAX_SITE_BYTES=104857600
#GITCHA_MAX_MEDIA_BYTES=52428800
#GITCHA_KEEP_DEPLOYS=10

# Hosting: the domains sites get subdomains on.  Use registrable domains other than the one above.
#GITCHA_HOSTING_DOMAINS=pages.example.net,apps.example.net
#GITCHA_HOSTING_CNAME=hosting.example.net

# Git over SSH (see sshd-gitcha.conf.example).
#GITCHA_SSH_HOST=gitcha.example.org
GITCHA_SSH_USER=git
#GITCHA_GIT_SHELL=/usr/bin/gitcha-git-shell
#GITCHA_INTERNAL_URL=http://127.0.0.1:4873   # what the SSH helpers call; read by them, not the server

# The ring: other Gitcha instances this one links to.
GITCHA_RING_NAME=Gitcha
#GITCHA_RING_DESCRIPTION=
#GITCHA_RING_OPERATOR=
#GITCHA_RING_PEERS=https://another.example
#GITCHA_RING_REFRESH=6h

# Two-factor policy: checks people cannot turn off (any of interval, new_network, sensitive).
#GITCHA_LOCKED_CHECKS=interval,new_network,sensitive

# CI and functions: the image used when a pipeline names none, how long a build may run, how long a call waits for a runner.
#GITCHA_DEFAULT_IMAGE=docker.io/library/node:22-alpine
#GITCHA_MAX_JOB_TIME=60m
#GITCHA_QUEUE_WAIT=20s
# Accept runtime "orgvm" (needs runners labelled orgvm).
#GITCHA_ORGVM=no

# Billing (off unless yes).  Keys only here, never in a repository.
#GITCHA_BILLING=yes
#GITCHA_PLANS_FILE=
#GITCHA_CURRENCY=USD
#GITCHA_AWARDS_FILE=
# GraphQL introspection (the schema query) answers only when this is yes.
#GITCHA_GRAPHQL_INTROSPECTION=no
#STRIPE_API_BASE=             # for testing against a stand-in
#PAYPAL_API_BASE=
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_PRO=
#STRIPE_PRICE_TEAM=
#PAYPAL_ENV=live
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_WEBHOOK_ID=
#PAYPAL_PLAN_PRO=
#PAYPAL_PLAN_TEAM=

# Mirror project tasks into NextTime (all four, or none).
#NEXTTIME_URL=
#NEXTTIME_USER=
#NEXTTIME_APP_PASSWORD=
#NEXTTIME_CATEGORY_ID=
#NEXTTIME_HOURS=1
# Complete the NextTime request when its Gitcha task is done (default yes).
#NEXTTIME_COMPLETE=yes
