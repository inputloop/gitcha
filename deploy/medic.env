# medic.env -- settings for gitcha-medic (a conffile: your edits survive upgrades).
# Copyright 2026 Corwin Brust <corwin@bru.st> and Bryant Frankford <nathanielfrankford@gmail.com> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
# Readable by root only (it may name an API key file).  Every setting the medic reads is listed here; a # line shows the
# default.  Packages built from debian/ write the debconf answers over these lines (dpkg-reconfigure inputloop-gitcha-medic).

# Who speaks: the name in syslog, Tavern and every message.  Default: gitcha-medic@<hostname>.
#GITCHA_MEDIC_IDENTITY=gitcha-medic@gw19

# What the medic may do by itself when the timer runs it:
#   report  say what it finds, change nothing
#   safe    also run the remedies of class safe: start a stopped service, restart a stuck one (gitcha-medic --list)
# A remedy that moves data or edits a file (class confirm) never runs from the timer: a person runs
#   sudo gitcha-medic --yes NAME   after reading what it does.
GITCHA_MEDIC_HEAL=report

# Where it speaks, a comma list of: syslog (always a good idea), tavern, chadgram, webhook, c4.
GITCHA_MEDIC_CHANNELS=syslog
# tavern: the agent.json Tavern writes in its data directory (port and agent token; read per call, never copied),
# the name the medic speaks as, and the room.
#GITCHA_MEDIC_TAVERN_AGENT_JSON=/var/lib/tavern/agent.json
#GITCHA_MEDIC_TAVERN_AS=medic@gw19
#GITCHA_MEDIC_TAVERN_ROOM=main
# chadgram: a JSONL file a chad.tab route appends from (one ilmsg/1 line per message), and the net name it carries.
#GITCHA_MEDIC_CHADGRAM_FILE=/var/lib/gitcha-medic/chad.jsonl
#GITCHA_MEDIC_CHADGRAM_NET=ops
# webhook: any URL that takes JSON by POST (a comic.chat or other room, until it has an adapter of its own).
#GITCHA_MEDIC_WEBHOOK_URL=
# c4: a folder postcards are dropped in, one file per message, for a hand move into a C4 tree.
#GITCHA_MEDIC_C4_DIR=
# How often the rooms hear from the medic when nothing has changed (syslog hears every run).
#GITCHA_MEDIC_REPEAT=6h

# The agent, for a second opinion when the rules do not explain what they see (and when --ask is given):
#   none      no agent (the default)
#   claude    the Claude API (api.anthropic.com), model GITCHA_MEDIC_AGENT_MODEL (default claude-opus-5-5)
#   local     TODO: an Ollama or llama-bridge endpoint at GITCHA_MEDIC_AGENT_URL (default http://127.0.0.1:11434)
#   inputloop TODO: a Mentat or Tavern resident, reached through Tavern or the Wire
#   openai    TODO: any OpenAI-compatible /v1/chat/completions server at GITCHA_MEDIC_AGENT_URL
# The agent sees redacted facts and may ask for safe remedies; it cannot grant consent for the others.
GITCHA_MEDIC_AGENT=none
#GITCHA_MEDIC_AGENT_MODEL=claude-opus-5-5
#GITCHA_MEDIC_AGENT_URL=https://api.anthropic.com
# The API key: in a file of its own, mode 600, read per call (preferred); or here (this file is mode 600 too).
#GITCHA_MEDIC_AGENT_KEY_FILE=/etc/inputloop/gitcha/agent.key
#GITCHA_MEDIC_AGENT_KEY=
# Effort (low, medium, high), how many tool rounds one consultation may take, and whether a declined request is
# re-run on a fallback model (yes or no).
#GITCHA_MEDIC_AGENT_EFFORT=medium
#GITCHA_MEDIC_AGENT_ROUNDS=8
#GITCHA_MEDIC_AGENT_FALLBACKS=yes

# Where the medic keeps its own small state (the last digest, so --quiet knows what changed), and which files tell
# it Gitcha's settings (as the gitcha unit reads them: gitcha.env, then debconf.env).
#GITCHA_MEDIC_STATE_DIR=/var/lib/gitcha-medic
#GITCHA_MEDIC_GITCHA_ENV=/etc/inputloop/gitcha/gitcha.env,/etc/inputloop/gitcha/debconf.env
