# sshd-gitcha.conf.example -- git over SSH for Gitcha.  Copy to /etc/ssh/sshd_config.d/gitcha.conf.
# Copyright 2026 Bryant Frankford <nathanielfrankford@gmail.com> and Corwin Brust <corwin@bru.st> and Contributors.
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
#
# Clone URLs read git@HOST:owner/name.git (GITCHA_SSH_USER=git).  Keys are looked up by fingerprint in
# Gitcha; each is forced through gitcha-git-shell, which runs only git-upload-pack / git-receive-pack, and only
# where that person or agent may read or write.
#
# Two accounts, not one.  The server runs as `gitcha` and owns the database and every secret.  SSH-served git
# runs outside the server's sandbox as whoever sshd runs it as, so that must be a different account, `git`,
# in group `gitcha`, which can read internal.key and the repositories and nothing else (see DEPLOY.md).
# Never put `gitcha` here.
Match User git
	AuthorizedKeysFile none
	AuthorizedKeysCommand /usr/bin/gitcha-ssh-keys %f
	AuthorizedKeysCommandUser git
	PasswordAuthentication no
	KbdInteractiveAuthentication no
	AllowTcpForwarding no
	X11Forwarding no
	PermitTTY no
	SetEnv GITCHA_DATA_DIR=/var/lib/gitcha
