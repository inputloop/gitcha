{
  "name": "gitcha-server",
  "version": "0.2.0",
  "description": "Gitcha: a free, self-hosted software package registry with mandatory two-factor authentication.",
  "license": "GPL-3.0-or-later OR LGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "gitcha-server": "src/index.js",
    "gitcha-ssh-keys": "bin/gitcha-ssh-keys.js",
    "gitcha-git-shell": "bin/gitcha-git-shell.js"
  },
  "main": "src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "test:strict": "GITCHA_STRICT_STORE=1 node --test test/*.test.js"
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "cassandra-driver": "^4.10.0"
  }
}
